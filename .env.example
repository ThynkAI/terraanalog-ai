# ---- FastAPI data/scoring service ----
# Folder containing the 9 data-contract files. Default: data/research (real TerraAnalog research outputs).
# Synthetic fallback for offline demos/tests: ./data/fixtures
TERRA_DATA_DIR=./data/research
# Comma-separated browser origins allowed to call the API directly (the UI normally goes through its server-side proxy).
TERRA_CORS_ORIGINS=http://localhost:3000

# ---- Next.js UI ----
# Where the Next.js server proxies /api/* (server-side only; never sent to the browser).
API_URL=http://127.0.0.1:8000
# Set to "standalone" for container builds (the Dockerfile sets it automatically).
# NEXT_OUTPUT=standalone
