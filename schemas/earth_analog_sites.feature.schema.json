{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "earth_analog_sites.geojson feature",
 "type": "object",
 "required": [
  "type",
  "id",
  "geometry",
  "properties"
 ],
 "properties": {
  "type": {
   "const": "Feature"
  },
  "id": {
   "type": "string",
   "pattern": "^EA-[0-9]{3}$"
  },
  "bbox": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 4,
   "maxItems": 4
  },
  "geometry": {
   "type": "object",
   "required": [
    "type",
    "coordinates"
   ],
   "properties": {
    "type": {
     "const": "Point"
    },
    "coordinates": {
     "type": "array",
     "prefixItems": [
      {
       "type": "number",
       "minimum": -180,
       "maximum": 180
      },
      {
       "type": "number",
       "minimum": -90,
       "maximum": 90
      }
     ]
    }
   }
  },
  "properties": {
   "type": "object",
   "required": [
    "site_id",
    "name",
    "country",
    "group",
    "best_moon_profile",
    "best_moon_score",
    "best_mars_profile",
    "best_mars_score",
    "scores",
    "operational_score",
    "limitations",
    "disclaimer"
   ],
   "properties": {
    "scores": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "fidelity_score",
       "fidelity_rank",
       "evidence_completeness",
       "confidence",
       "matched_reference_id"
      ]
     }
    }
   }
  }
 }
}